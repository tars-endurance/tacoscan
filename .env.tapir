# Tapir Testnet Configuration
# Network identifier
VITE_NETWORK=tapir

# Network Switcher URLs
VITE_MAINNET_URL=https://tacoscan-7th5b.ondigitalocean.app
VITE_LYNX_URL=https://tacoscan-lynx-3f5rb.ondigitalocean.app
VITE_TAPIR_URL=https://tacoscan-tapir-l92h3.ondigitalocean.app

# RPC Endpoints (using same var names as mainnet for compatibility)
VITE_RPC_ETH_MAINNET=https://sepolia.infura.io/v3/0b802427db2e42e18e8eadd1ec01f934
VITE_RPC_ETH_POLYGON=https://polygon-amoy.infura.io/v3/0b802427db2e42e18e8eadd1ec01f934

# Subgraph API (Goldsky)
VITE_SUBGRAPH_ETHEREUM=https://api.goldsky.com/api/public/project_cmgzo6cgq00lc5np2dwaycfdl/subgraphs/taco-tapir-ethereum/latest/gn
VITE_SUBGRAPH_POLYGON=https://api.goldsky.com/api/public/project_cmgzo6cgq00lc5np2dwaycfdl/subgraphs/taco-tapir-polygon/latest/gn
VITE_SUBGRAPH_BASE=https://api.goldsky.com/api/public/project_cmgzo6cgq00lc5np2dwaycfdl/subgraphs/taco-tapir-base/latest/gn

# Etherscan API (using same var name as mainnet for compatibility)
VITE_MAINNET_AP_BALANCE=your_etherscan_api_key_here

# WalletConnect Configuration
VITE_REACT_APP_WALLET_CONNECT_PROJECT_ID=788753258a7a69b551cff57742637490

# Chain Configuration
VITE_CHAIN_ID=11155111
VITE_CHAIN_NAME=Sepolia (Tapir)

# Contract Addresses Override (if different from artifacts)
# VITE_TACO_APPLICATION_ADDRESS=0x...
# VITE_COORDINATOR_ADDRESS=0x...

# Optional: Enhanced RPC providers
# VITE_ALCHEMY_API_KEY=your_alchemy_key_here
# VITE_INFURA_API_KEY=your_infura_key_here
